{
  "expo": {
    "name": "App Financiera Personal",
    "slug": "finanzas-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finpersonal",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.finpersonal.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Para escanear capturas de pago con OCR"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para seleccionar capturas de pago de la galería"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3B82F6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "27a36283-c42e-4770-8f70-c39032dae1a5"
      }
    },
    "owner": "finanzas-app"
  }
}
